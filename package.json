{
  "name": "personal-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal, content-first personal blog built with Next.js + TypeScript + Tailwind CSS + Markdown.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/preview.mjs",
    "verify": "node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit",
    "new": "node scripts/new-post.mjs",
    "publish:post": "node scripts/publish-obsidian-post.mjs",
    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "katex": "^0.16.25",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3"
  }
}
